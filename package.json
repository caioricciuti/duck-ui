{
  "name": "duck-ui",
  "private": true,
  "version": "2.2.0",
  "release_date": "2026-10-02",
  "type": "module",
  "bin": {
    "duck-ui": "cli/duck-ui.js"
  },
  "files": [
    "dist",
    "cli",
    "!cli/__tests__",
    "serve.json"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "lint": "svelte-check --tsconfig ./tsconfig.app.json --fail-on-warnings",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\"",
    "typecheck": "svelte-check --tsconfig ./tsconfig.app.json && tsc -p tsconfig.node.json",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.2",
    "@codemirror/commands": "6.10.3",
    "@codemirror/lang-markdown": "6.5.2",
    "@codemirror/lang-python": "6.2.1",
    "@codemirror/lang-sql": "6.10.0",
    "@codemirror/language": "6.12.3",
    "@codemirror/search": "6.7.0",
    "@codemirror/state": "6.6.0",
    "@codemirror/view": "6.42.1",
    "@duckdb/duckdb-wasm": "1.33.1-dev64.0",
    "@lezer/highlight": "1.2.3",
    "@mlc-ai/web-llm": "^0.2.84",
    "@tailwindcss/vite": "^4.3.3",
    "apache-arrow": "^17.0.0",
    "dompurify": "3.4.15",
    "exceljs": "^4.4.0",
    "fflate": "^0.8.3",
    "lucide-svelte": "1.0.1",
    "maplibre-gl": "^6.11.2",
    "marked": "18.0.3",
    "sql-formatter": "^15.8.2",
    "svelte-sonner": "1.1.1",
    "uplot": "^1.6.32",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.32",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@sveltejs/vite-plugin-svelte": "7.1.2",
    "@tsconfig/svelte": "5.0.8",
    "@types/node": "26.0.1",
    "baseline-browser-mapping": "^2.11.15",
    "esbuild": "^0.25.12",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "svelte": "5.57.0",
    "svelte-check": "4.4.8",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vite": "8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "5.0.0"
  },
  "description": "Fully open-source DuckDB workbench that runs in your browser. SQL editor, notebooks, charts, AI assistant, and shareable analyses powered by DuckDB WASM — no backend, your data never leaves the tab.",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caioricciuti/duck-ui.git"
  },
  "keywords": [
    "duckdb",
    "duckdb-wasm",
    "sql",
    "sql-editor",
    "data-analysis",
    "data-visualization",
    "analytics",
    "olap",
    "parquet",
    "csv",
    "ducklake",
    "text-to-sql",
    "local-first",
    "browser"
  ],
  "author": "Caio Ricciuti",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/caioricciuti/duck-ui/issues"
  },
  "homepage": "https://github.com/caioricciuti/duck-ui#readme",
  "lint-staged": {
    "src/**/*.{ts,css}": "prettier --write"
  },
  "overrides": {
    "picomatch": "^4.0.4",
    "flatted": "^3.4.2"
  }
}
