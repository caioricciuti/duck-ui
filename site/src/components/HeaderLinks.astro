---
// Starlight's header ends with the social icons. This puts the site's own
// links and the app button in front of them.
import Default from "@astrojs/starlight/components/SocialIcons.astro";

const path = Astro.url.pathname;
const links = [
  { href: "/docs/", label: "Docs", active: path.startsWith("/docs/") && !path.startsWith("/docs/examples/") },
  { href: "/docs/examples/", label: "Examples", active: path.startsWith("/docs/examples/") },
];
---

<nav class="duck-links" aria-label="Site">
  {links.map((l) => (
    <a href={l.href} aria-current={l.active ? "page" : undefined}>{l.label}</a>
  ))}
  <a class="duck-open" href="https://duckui.com">Open app</a>
</nav>
<Default />

<style>
  .duck-links {
    display: flex;
    align-items: center;
    gap: 0.25rem;
    margin-inline-end: 0.5rem;
  }
  .duck-links a {
    padding: 0.3rem 0.6rem;
    font-size: 0.8125rem;
    color: var(--sl-color-gray-3);
    text-decoration: none;
    transition: color 0.15s ease;
  }
  .duck-links a:hover,
  .duck-links a[aria-current="page"] {
    color: var(--sl-color-white);
  }
  .duck-links a.duck-open {
    display: inline-flex;
    align-items: center;
    height: 1.9rem;
    margin-inline-start: 0.5rem;
    padding: 0 0.8rem;
    border: 1px solid var(--sl-color-hairline-shade);
    border-radius: 999px;
    color: var(--sl-color-white);
    font-weight: 500;
  }
  .duck-links a.duck-open:hover {
    background: var(--sl-color-gray-6);
  }
  @media (max-width: 50rem) {
    .duck-links {
      display: none;
    }
  }
</style>
